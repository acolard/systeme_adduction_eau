        <mxCell id="6-uEAo-Kq3mGAs13d5aC-65" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" value="&lt;h2 data-start=&quot;232&quot; data-end=&quot;313&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;✅ &lt;strong data-start=&quot;237&quot; data-end=&quot;313&quot;&gt;La relation &amp;lt;&amp;lt; deriveReqt &amp;gt;&amp;gt; indique qu’une exigence dérive d’une autre.&lt;/strong&gt;&lt;/font&gt;&lt;/h2&gt;&lt;u&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Exemple :&lt;br&gt;&lt;/font&gt;&lt;/u&gt;&lt;p data-start=&quot;315&quot; data-end=&quot;490&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;De l&#39;exigence &quot;Filtration - Id=1.1.1&quot; on dérive les exigences &quot;Microfiltration - id=1.1.1.1&quot; et &quot;Qualité de l&#39;eau - id=1.1.1.2&quot;&lt;/span&gt;&lt;/p&gt;&lt;h2 data-start=&quot;840&quot; data-end=&quot;918&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;✅ &lt;strong data-start=&quot;845&quot; data-end=&quot;918&quot;&gt;La relation &amp;lt;&amp;lt; refine &amp;gt;&amp;gt; indique qu’un élément apporte une description plus détaillée, un complément, ou une interprétation plus précise d’une autre exigence&lt;/strong&gt;&lt;/font&gt;&lt;/h2&gt;&lt;u&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Exemple :&lt;br&gt;&lt;/font&gt;&lt;/u&gt;&lt;p data-start=&quot;920&quot; data-end=&quot;952&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;L&#39;exigence de performance mesurable et vérifiable &quot;&lt;/span&gt;&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212)); font-size: 10px;&quot;&gt;Diamètre des particules - Id=1.1.1.1.1&quot; précise l&#39;exigence &quot;&lt;/span&gt;&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212)); font-size: 10px;&quot;&gt;Microfiltration - Id=1.1.1.1&quot;&lt;/span&gt;&lt;/p&gt;" vertex="1">
